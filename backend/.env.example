# ParkZee Backend Environment Configuration

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Connection String (MongoDB Atlas in Production, or local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/parkzee

# JWT Security Secrets (Replace with cryptographically random strings in production)
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Optional trusted administrator bootstrap. If configured, startup creates or resets this admin.
# Never use public registration to create an administrator.
ADMIN_BOOTSTRAP_EMAIL=admin@parkzee.com
ADMIN_BOOTSTRAP_PASSWORD=admin@parkzee123
ADMIN_BOOTSTRAP_NAME=ParkZee Administrator

# Frontend URL & CORS Origins (Comma-separated)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary Storage (Optional - for photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=no-reply@parkzee.com

# Booking Engine Configuration
RESERVATION_GRACE_PERIOD_MINUTES=15
